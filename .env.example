# Copy to .env on the portal LXC (never commit real secrets)
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-random
# Optional Tailscale API (OAuth client or API access token)
TAILSCALE_API_KEY=   # must be tskey-api-... (not tskey-auth-)

TAILSCALE_TAILNET=
TAILSCALE_TAG_STUDENT=tag:lab-student
TAILSCALE_TAG_ACCESS=tag:lab-access
# Base URL students see in links (portal public URL or Tailscale IP later)
PORTAL_PUBLIC_URL=http://172.16.10.150:8080

# PDM / Proxmox — leave disabled or empty so approve stays offline-safe.
# Put real tokens in Vault, then render into LXC .env — never git.
PROVISION_OFFLINE=1
PDM_ENABLED=0
PDM_URL=
PDM_TOKEN=
PROXMOX_ENABLED=0
PROXMOX_HOST=
PROXMOX_USER=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# Template VMIDs (Phase 3) — placeholders only
PROXMOX_TEMPLATE_PA=
PROXMOX_TEMPLATE_CLIENT=
PROXMOX_TEMPLATE_DMZ=
PROXMOX_TEMPLATE_VROUTER=
PROXMOX_TEMPLATE_ACCESS_LXC=
